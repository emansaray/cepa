{
  "name": "cepa-backend",
  "version": "1.0.0",
  "description": "CEPA — Community Evidence for Progressive Action — API server",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:studio": "prisma studio",
    "seed": "node prisma/seed.js",
    sqlite:generate": "prisma generate --schema=prisma/schema.sqlite.prisma",
    "sqlite:migrate": "prisma migrate dev --name init --schema=prisma/schema.sqlite.prisma",
    "sqlite:studio": "prisma studio --schema=prisma/schema.sqlite.prisma",
    "postgres:generate": "prisma generate --schema=prisma/schema.postgres.prisma",
    "postgres:migrate": "prisma migrate deploy --schema=prisma/schema.postgres.prisma",
    "postgres:migrate:dev": "prisma migrate dev --name init --schema=prisma/schema.postgres.prisma",
    "postgres:studio": "prisma studio --schema=prisma/schema.postgres.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^5.19.1"
  }
}
