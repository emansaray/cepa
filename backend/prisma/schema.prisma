// CEPA — Community Evidence for Progressive Action
// Prisma schema targeting Microsoft SQL Server

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  MODERATOR
  ADMIN
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.NVarChar(50)
  email        String   @unique @db.NVarChar(255)
  passwordHash String   @db.NVarChar(255)
  displayName  String   @db.NVarChar(100)
  bio          String?  @db.NVarChar(500)
  role         Role     @default(MEMBER)
  createdAt    DateTime @default(now())

  threads Thread[]
  replies Reply[]
  votes   Vote[]

  @@map("users")
}

model Category {
  id          Int      @id @default(autoincrement())
  slug        String   @unique @db.NVarChar(80)
  name        String   @db.NVarChar(120)
  description String   @db.NVarChar(400)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  threads Thread[]

  @@map("categories")
}

model Thread {
  id         Int      @id @default(autoincrement())
  title      String   @db.NVarChar(200)
  body       String   @db.NVarChar(4000)
  isPinned   Boolean  @default(false)
  isLocked   Boolean  @default(false)
  viewCount  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  authorId Int
  author   User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  replies Reply[]
  votes   Vote[]

  @@index([categoryId])
  @@map("threads")
}

model Reply {
  id        Int      @id @default(autoincrement())
  body      String   @db.NVarChar(4000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  threadId Int
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  authorId Int
  author   User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  votes    Vote[]

  @@index([threadId])
  @@map("replies")
}

model Vote {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  threadId Int?
  thread   Thread? @relation(fields: [threadId], references: [id], onDelete: Cascade)

  replyId Int?
  reply   Reply? @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
  @@unique([userId, replyId])
  @@map("votes")
}
